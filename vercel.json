{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/seo.js": { "includeFiles": "dist/_seo/template.html" }
  },
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/login", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/cadastro", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/:page(admin|login|cadastro|404).html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/api/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/_seo/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:page(admin|login|cadastro)/", "destination": "/:page", "permanent": true },
    { "source": "/:page(admin|login|cadastro).html", "destination": "/:page", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/seo?route=sitemap" },
    { "source": "/produto/:id", "destination": "/api/seo?route=product&productId=:id" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/cadastro", "destination": "/cadastro.html" },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/.*).+)",
      "destination": "/api/seo?route=notfound"
    }
  ]
}
